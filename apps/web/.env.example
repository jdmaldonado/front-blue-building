# Copia este archivo como `.env` y ajusta los valores.
# Ambas variables son obligatorias: la app no arranca sin ellas.

VITE_API_BASE_URL=http://localhost:3000

# http(s), no ws(s): socket.io hace el handshake por HTTP y sube a WebSocket solo.
# Hoy apunta al mismo origen que la API.
VITE_SOCKET_URL=http://localhost:3000

# Opcional. Qué app es este despliegue: `resident` (por defecto) o `admin`.
# Cada una va en su propio proyecto de Vercel, con su URL, para instalarse aparte.
# VITE_APP_KIND=admin
