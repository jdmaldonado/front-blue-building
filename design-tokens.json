{
  "$meta": {
    "name": "Blue Building Design System",
    "colorSpace": "oklch",
    "themes": ["light", "dark"],
    "layers": "primitives → semantic (theming lives here, per theme) → components (theme-agnostic aliases to semantic roles, resolved in the active theme)"
  },
  "primitives": {
    "color": {
      "cyan": {
        "100": "oklch(0.95 0.03 215)",
        "200": "oklch(0.89 0.06 215)",
        "300": "oklch(0.80 0.10 213)",
        "400": "oklch(0.72 0.13 215)",
        "500": "oklch(0.60 0.125 224)",
        "600": "oklch(0.50 0.105 228)",
        "700": "oklch(0.40 0.085 232)"
      },
      "ink": {
        "000": "oklch(0.99 0.003 235)",
        "050": "oklch(0.972 0.005 235)",
        "100": "oklch(0.93 0.008 235)",
        "200": "oklch(0.865 0.012 235)",
        "300": "oklch(0.72 0.015 235)",
        "400": "oklch(0.55 0.02 236)",
        "500": "oklch(0.45 0.025 238)",
        "600": "oklch(0.35 0.03 240)",
        "700": "oklch(0.29 0.032 240)",
        "800": "oklch(0.225 0.03 242)",
        "900": "oklch(0.175 0.025 242)",
        "950": "oklch(0.14 0.02 244)",
        "975": "oklch(0.11 0.017 244)"
      },
      "red": {
        "400": "oklch(0.68 0.16 25)",
        "500": "oklch(0.56 0.17 25)"
      },
      "amber": {
        "400": "oklch(0.78 0.14 80)",
        "500": "oklch(0.66 0.13 70)"
      },
      "green": {
        "400": "oklch(0.72 0.14 155)",
        "500": "oklch(0.58 0.13 155)"
      }
    },
    "font": {
      "display": "'Space Grotesk', sans-serif",
      "body": "'IBM Plex Sans', sans-serif",
      "mono": "'IBM Plex Mono', monospace"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "64px"
    },
    "radius": {
      "1": "6px",
      "2": "10px",
      "3": "16px",
      "round": "999px"
    }
  },
  "semantic": {
    "light": {
      "surface": {
        "base": "{color.ink.050}",
        "raised": "{color.ink.000}",
        "sunken": "{color.ink.100}",
        "inverse": "{color.ink.900}"
      },
      "text": {
        "primary": "{color.ink.900}",
        "secondary": "{color.ink.500}",
        "muted": "{color.ink.400}",
        "on-accent": "{color.ink.000}",
        "inverse": "{color.ink.050}"
      },
      "border": {
        "default": "{color.ink.200}",
        "strong": "{color.ink.300}",
        "focus": "{color.cyan.500}"
      },
      "accent": {
        "default": "{color.cyan.500}",
        "hover": "{color.cyan.600}",
        "subtle": "{color.cyan.100}"
      },
      "status": {
        "destructive": "{color.red.500}",
        "destructive-subtle": "oklch(0.95 0.025 25)",
        "warning": "{color.amber.500}",
        "warning-subtle": "oklch(0.95 0.03 80)",
        "success": "{color.green.500}",
        "success-subtle": "oklch(0.955 0.03 155)",
        "door-open": "{color.green.500}",
        "door-closed": "{color.ink.400}"
      },
      "alert": {
        "info": {
          "bg": "{color.cyan.100}",
          "border": "{color.cyan.500}",
          "title": "{color.cyan.500}",
          "text": "oklch(0.44 0.09 228)"
        },
        "warning": {
          "bg": "oklch(0.95 0.03 80)",
          "border": "{color.amber.500}",
          "title": "oklch(0.50 0.12 70)",
          "text": "oklch(0.44 0.09 70)"
        },
        "error": {
          "bg": "oklch(0.95 0.025 25)",
          "border": "{color.red.500}",
          "title": "{color.red.500}",
          "text": "oklch(0.45 0.15 25)"
        },
        "success": {
          "bg": "oklch(0.955 0.03 155)",
          "border": "{color.green.500}",
          "title": "oklch(0.46 0.12 155)",
          "text": "oklch(0.40 0.10 155)"
        }
      },
      "shadow": {
        "1": "0 1px 2px oklch(0.2 0.02 242/.06), 0 2px 8px oklch(0.2 0.02 242/.05)",
        "2": "0 4px 16px oklch(0.2 0.02 242/.12)",
        "3": "0 12px 40px oklch(0.2 0.02 242/.18), 0 4px 12px oklch(0.2 0.02 242/.08)"
      }
    },
    "dark": {
      "surface": {
        "base": "{color.ink.950}",
        "raised": "{color.ink.900}",
        "sunken": "{color.ink.975}",
        "inverse": "{color.ink.050}"
      },
      "text": {
        "primary": "{color.ink.050}",
        "secondary": "{color.ink.300}",
        "muted": "{color.ink.500}",
        "on-accent": "{color.ink.975}",
        "inverse": "{color.ink.900}"
      },
      "border": {
        "default": "{color.ink.800}",
        "strong": "{color.ink.600}",
        "focus": "{color.cyan.400}"
      },
      "accent": {
        "default": "{color.cyan.400}",
        "hover": "{color.cyan.300}",
        "subtle": "oklch(0.26 0.05 224)"
      },
      "status": {
        "destructive": "{color.red.400}",
        "destructive-subtle": "oklch(0.24 0.06 25)",
        "warning": "{color.amber.400}",
        "warning-subtle": "oklch(0.24 0.05 80)",
        "success": "{color.green.400}",
        "success-subtle": "oklch(0.24 0.05 155)",
        "door-open": "{color.green.400}",
        "door-closed": "{color.ink.500}"
      },
      "alert": {
        "info": {
          "bg": "oklch(0.26 0.05 224)",
          "border": "{color.cyan.400}",
          "title": "{color.cyan.400}",
          "text": "oklch(0.84 0.07 224)"
        },
        "warning": {
          "bg": "oklch(0.24 0.05 80)",
          "border": "{color.amber.400}",
          "title": "{color.amber.400}",
          "text": "oklch(0.86 0.09 80)"
        },
        "error": {
          "bg": "oklch(0.24 0.06 25)",
          "border": "{color.red.400}",
          "title": "{color.red.400}",
          "text": "oklch(0.82 0.10 25)"
        },
        "success": {
          "bg": "oklch(0.24 0.05 155)",
          "border": "{color.green.400}",
          "title": "{color.green.400}",
          "text": "oklch(0.84 0.10 155)"
        }
      },
      "shadow": {
        "1": "0 1px 2px oklch(0 0 0/.4), 0 2px 8px oklch(0 0 0/.3)",
        "2": "0 4px 16px oklch(0 0 0/.5)",
        "3": "0 12px 40px oklch(0 0 0/.6), 0 4px 12px oklch(0 0 0/.4)"
      }
    }
  },
  "components": {
    "$note": "Consume solo semantic/primitives. Idéntico en ambos temas: cada alias se resuelve en el tema activo. {group.leaf} sin prefijo = primitivo; {semantic.group.leaf} = rol semántico.",
    "button": {
      "primary-bg": "{semantic.accent.default}",
      "primary-bg-hover": "{semantic.accent.hover}",
      "primary-foreground": "{semantic.text.on-accent}",
      "destructive-bg": "{semantic.status.destructive}",
      "radius": "{radius.2}"
    },
    "input": {
      "bg": "{semantic.surface.raised}",
      "border": "{semantic.border.default}",
      "border-focus": "{semantic.border.focus}",
      "foreground": "{semantic.text.primary}",
      "placeholder": "{semantic.text.muted}",
      "radius": "{radius.2}"
    },
    "card": {
      "bg": "{semantic.surface.raised}",
      "border": "{semantic.border.default}",
      "radius": "{radius.3}"
    },
    "status-dot": {
      "online": "{semantic.status.success}",
      "offline": "{semantic.status.door-closed}"
    },
    "checkbox": {
      "border": "{semantic.border.strong}",
      "bg-checked": "{semantic.accent.default}",
      "foreground": "{semantic.text.on-accent}"
    },
    "toggle": {
      "track-off": "{semantic.surface.sunken}",
      "track-on": "{semantic.accent.default}",
      "knob": "{semantic.surface.raised}",
      "border": "{semantic.border.strong}"
    },
    "tab": {
      "foreground": "{semantic.text.secondary}",
      "foreground-active": "{semantic.text.primary}",
      "indicator": "{semantic.accent.default}"
    },
    "menu": {
      "bg": "{semantic.surface.raised}",
      "border": "{semantic.border.default}",
      "hover": "{semantic.surface.sunken}",
      "selected-bg": "{semantic.accent.subtle}",
      "selected-foreground": "{semantic.accent.default}"
    },
    "table": {
      "header-bg": "{semantic.surface.sunken}",
      "row-hover": "{semantic.surface.sunken}",
      "row-selected": "{semantic.accent.subtle}",
      "border": "{semantic.border.default}"
    },
    "avatar": {
      "bg": "{semantic.accent.subtle}",
      "foreground": "{semantic.accent.default}"
    },
    "icon-button": {
      "foreground": "{semantic.text.secondary}",
      "bg-hover": "{semantic.surface.sunken}"
    }
  }
}
